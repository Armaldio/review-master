{
  "name": "review-master",
  "version": "3.0.0",
  "description": "A focused GitLab merge request review tool",
  "license": "MIT",
  "type": "module",
  "bin": {
    "review-master": "bin/review-master.mjs"
  },
  "files": [
    ".output",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "test": "node --test test/*.test.mjs",
    "benchmark": "node bench/benchmark.mjs",
    "benchmark:browser": "node bench/browser.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.2",
    "dompurify": "^3.4.16",
    "marked": "^17.0.5",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.1",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.6"
  }
}
